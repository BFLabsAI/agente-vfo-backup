# ── DataCrazy API (WhatsApp messaging) ─────────
DATACRAZY_API_TOKEN=<seu_token_datacrazy>
DATACRAZY_BASE_URL=https://api.g1.datacrazy.io
DATACRAZY_INSTANCE_ID=<instance_id_do_numero>
# ── LLM — OmniRoute (OpenAI-compatible) ─────
OMNIROUTE_API_KEY=<informe a sua chave>
OMNIROUTE_MODEL_ID=xiaomi-mimo/mimo-v2.5-pro
OMNIROUTE_BASE_URL=<informe a URL do seu endpoint OpenAI-compativel>
OMNIROUTE_MEDIA_MODEL_ID=mimo/mimo-v2.5
OMNIROUTE_AUDIO_MODEL_ID=deepgram/nova-3
OMNIROUTE_VISION_FALLBACK_MODEL=gweb/gemini-2.5-flash

# ── Session Storage ───────────────────────────
SESSION_DB_PATH=instances/<nome>/data/vanessa.db

# ── Porta ──────────────────────────────────────
PORT=8004

# ── Comercial ─────────────────────────────────
PAYMENT_LINK=<link_de_pagamento>
NURTURE_CONTENT_LINK=<link_de_conteudo>

# ── Webhook de confirmação de pagamento (opcional) ─
PAYMENT_WEBHOOK_SECRET=
